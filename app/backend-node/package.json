{
  "name": "daamdekho-backend",
  "version": "1.0.0",
  "description": "DaamDekho production price comparison backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "setup-db": "node utils/setup-database.js",
    "update-offers": "node utils/update-offers.js",
    "migrate": "node migrations/001_price_refresh_schema.js",
    "worker:price-refresh": "node workers/priceRefreshWorker.js",
    "price:check": "node scripts/checkPriceCli.js",
    "price:refresh": "node scripts/checkPriceCli.js --commit"
  },
  "keywords": [
    "price comparison",
    "ecommerce",
    "product discovery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "sqlite3": "^5.1.6",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
